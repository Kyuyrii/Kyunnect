# ---------- Translations ----------
try:
    locale.setlocale(locale.LC_ALL, "")
    LANG, _ = locale.getlocale(locale.LC_CTYPE)
except locale.Error:
    LANG = "en_US"
if not LANG:
    LANG = "en_US"


def load_translations():
    translations = {}
    languages = []
    seen = set()
    app_dir = Path(__file__).resolve().parent
    search_dirs = [
        app_dir / "translation",
        Path(sys.argv[0]).resolve().parent / "translation",
        kyunnect_translation_dir,
    ]
    if "XDG_DATA_DIRS" in os.environ:
        for p in os.environ["XDG_DATA_DIRS"].split(":"):
            if p:
                search_dirs.append(Path(p) / "Kyunnect" / "translation")
    else:
        search_dirs.append(Path("/usr/share/Kyunnect/translation"))
        search_dirs.append(Path("/usr/local/share/Kyunnect/translation"))

    for folder in search_dirs:
        if not folder.exists():
            continue
        for toml_file in folder.glob("kyunnect-translation-*.toml"):
            try:
                code = toml_file.stem.replace("kyunnect-translation-", "")
                if code in seen:
                    continue
                with open(toml_file, "r", encoding="utf-8") as f:
                    data = tomlkit.load(f)
                translations[code] = data
                name = data.get("language_name", code)
                languages.append((name, code))
                seen.add(code)
                print(f"[Kyunnect]: Loaded translation: {name} ({code})")
            except Exception as e:
                print(f"[Kyunnect]: Error loading {toml_file}: {e}")
    return translations, languages


available_translations, available_languages = load_translations()


def tr(key, **kwargs):
    if LANG in available_translations:
        s = available_translations[LANG].get(key)
        if s:
            s = s.replace("{__version__}", __version__)
            try:
                return s.format(**kwargs)
            except (KeyError, ValueError):
                return s
    return key


def load_settings():
    try:
        if kyunnect_settings_file.is_file():
            with open(kyunnect_settings_file, "r", encoding="utf-8") as f:
                return dict(tomlkit.load(f))
    except Exception as e:
        print(f"[Kyunnect]: failed to load settings: {e}")
    return {}


def save_settings(updates):
    try:
        data = load_settings()
        data.update(updates)
        doc = tomlkit.document()
        for k, v in data.items():
            doc[k] = v
        with open(kyunnect_settings_file, "w", encoding="utf-8") as f:
            tomlkit.dump(doc, f)
    except Exception as e:
        print(f"[Kyunnect]: failed to save settings: {e}")


_settings = load_settings()
if _settings.get("language") in available_translations:
    LANG = _settings["language"]
elif LANG not in available_translations:
    LANG = "en_US"


# ---------- Snap data ----------
def get_app_info():
    try:
        out = subprocess.check_output(["snap", "list"], text=True).strip().split("\n")
        if len(out) <= 1:
            return []
        apps = []
        for line in out[1:]:
            parts = line.split()
            if not parts:
                continue
            name = parts[0]
            if name in EXCLUDED_APPS:
                continue
            notes = parts[-1].lower() if len(parts) >= 6 else ""
            if "classic" in notes:
                continue
            note_tokens = set(notes.replace(",", " ").split())
            if note_tokens & RUNTIME_NOTES:
                continue
            if "disabled" in notes:
                continue
            desktop_files = globmod.glob(f"/var/lib/snapd/desktop/applications/{name}*.desktop")
            icon = ""
            if desktop_files:
                try:
                    with open(desktop_files[0], "r", encoding="utf-8", errors="ignore") as f:
                        for fl in f:
                            if fl.startswith("Icon="):
                                icon = fl.strip().split("=", 1)[1]
                                break
                except Exception:
                    pass
            if not icon:
                continue
            apps.append((name, icon))
        return apps
    except (FileNotFoundError, subprocess.CalledProcessError):
        return []


def get_plug_status(app_name):
    status = {}
    try:
        out = subprocess.check_output(["snap", "connections", app_name], text=True).strip().split("\n")
        for line in out[1:]:
            parts = line.split()
            if len(parts) < 3:
                continue
            plug = parts[0]
            if plug.startswith("content["):
                continue
            if plug not in VISIBLE_PLUGS:
                continue
            plug_full = parts[1]
            if ":" not in plug_full:
                continue
            plug_name = plug_full.split(":", 1)[1]
            if plug_name != plug:
                continue
            status[plug] = parts[2] != "-"
    except Exception:
        pass
    return status


# ---------- Caching ----------
_cache = {}
_cache_time = {}
CACHE_TTL = 3.0


def _cached(key, func, *args):
    now = time.monotonic()
    if key in _cache and (now - _cache_time[key]) < CACHE_TTL:
        return _cache[key]
    value = func(*args)
    _cache[key] = value
    _cache_time[key] = now
    return value


def get_app_info_cached():
    return _cached(("app_info",), get_app_info)


def get_plug_status_cached(app_name):
    return _cached(("plug_status", app_name), get_plug_status, app_name)


def invalidate_cache():
    _cache.clear()
    _cache_time.clear()


def get_plug_description(plug):
    key = "PLUG_" + plug.upper().replace("-", "_")
    translated = tr(key)
    if translated != key:
        return translated
    return plug


def get_plug_icon(plug):
    return PLUG_ICONS.get(plug, "application-x-executable")


# ---------- Async pkexec ----------
class _Bridge(QObject):
    done = pyqtSignal(bool)


def run_pkexec_commands(commands, bridge):
    def worker():
        if not commands:
            bridge.done.emit(True)
            return
        joined = " && ".join(" ".join(c) for c in commands)
        full = ["pkexec", "sh", "-c", joined]
        try:
            subprocess.run(full, check=True)
            bridge.done.emit(True)
        except subprocess.CalledProcessError:
            bridge.done.emit(False)
        except Exception as e:
            print(f"[Kyunnect]: pkexec error: {e}")
            bridge.done.emit(False)
    t = threading.Thread(target=worker, daemon=True)
    t.start()


# ---------- Helpers ----------
def make_icon_widget(icon_spec, size=20):
    lbl = QLabel()
    lbl.setFixedSize(size, size)
    lbl.setAlignment(Qt.AlignmentFlag.AlignCenter)
    if icon_spec and os.path.isabs(icon_spec) and os.path.isfile(icon_spec):
        pix = QPixmap(icon_spec)
        if not pix.isNull():
            lbl.setPixmap(pix.scaled(size, size, Qt.AspectRatioMode.KeepAspectRatio,
                                     Qt.TransformationMode.SmoothTransformation))
            return lbl
    icon = QIcon.fromTheme(icon_spec or "application-x-executable")
    if not icon.isNull():
        pix = icon.pixmap(size, size)
        if not pix.isNull():
            lbl.setPixmap(pix)
        else:
            lbl.setText("?")
    else:
        lbl.setText("?")
    return lbl


def make_sidebar_row(app_name, icon_spec):
    widget = QWidget()
    hbox = QHBoxLayout(widget)
    hbox.setContentsMargins(8, 4, 8, 4)
    hbox.setSpacing(8)
    hbox.addWidget(make_icon_widget(icon_spec, 20), 0)
    label = QLabel(app_name)
    label.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Preferred)
    hbox.addWidget(label, 1)
    return widget


def make_global_sidebar_row():
    widget = QWidget()
    hbox = QHBoxLayout(widget)
    hbox.setContentsMargins(8, 4, 8, 4)
    hbox.setSpacing(8)
    hbox.addWidget(make_icon_widget("preferences-system", 20), 0)
    label = QLabel(tr("GLOBAL_NAME"))
    label.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Preferred)
    hbox.addWidget(label, 1)
    return widget


def make_plug_row(plug, description, is_connected):
    widget = QWidget()
    hbox = QHBoxLayout(widget)
    hbox.setContentsMargins(8, 4, 8, 4)
    hbox.setSpacing(8)

    switch = QCheckBox()
    switch.setChecked(is_connected)
    hbox.addWidget(switch, 0, Qt.AlignmentFlag.AlignVCenter)

    hbox.addWidget(make_icon_widget(get_plug_icon(plug), 16), 0)

    vbox = QVBoxLayout()
    vbox.setSpacing(0)
    desc_label = QLabel(description)
    vbox.addWidget(desc_label)
    name_label = QLabel(plug)
    vbox.addWidget(name_label)
    hbox.addLayout(vbox, 1)

    widget.switch = switch
    return widget


# ---------- Sidebar ----------
class Sidebar(QScrollArea):
    selection_changed = pyqtSignal(str)

    def __init__(self):
        super().__init__()
        self._suppress = False
        self.setWidgetResizable(True)
        self.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)

        self.list = QListWidget()
        self.list.setSelectionMode(QListWidget.SelectionMode.SingleSelection)
        self.list.currentItemChanged.connect(self._on_current_changed)
        self.setWidget(self.list)

        self.reload()

    def reload(self):
        self._suppress = True
        self.list.clear()

        item = QListWidgetItem()
        item.setData(Qt.ItemDataRole.UserRole, tr("GLOBAL_NAME"))
        w = make_global_sidebar_row()
        item.setSizeHint(w.sizeHint())
        self.list.addItem(item)
        self.list.setItemWidget(item, w)

        for app_name, icon_spec in get_app_info_cached():
            item = QListWidgetItem()
            item.setData(Qt.ItemDataRole.UserRole, app_name)
            w = make_sidebar_row(app_name, icon_spec)
            item.setSizeHint(w.sizeHint())
            self.list.addItem(item)
            self.list.setItemWidget(item, w)

        self._suppress = False

    def _on_current_changed(self, current, _previous):
        if self._suppress or current is None:
            return
        app_name = current.data(Qt.ItemDataRole.UserRole)
        if app_name:
            self.selection_changed.emit(app_name)

    def select_first(self):
        self._suppress = True
        self.list.setCurrentRow(0)
        self._suppress = False
        item = self.list.item(0)
        if item is not None:
            app_name = item.data(Qt.ItemDataRole.UserRole)
            if app_name:
                self.selection_changed.emit(app_name)


# ---------- Detail panel ----------
class DetailPanel(QWidget):
    state_changed = pyqtSignal()

    def __init__(self):
        super().__init__()
        self.app_name = None
        self.rows = []
        self._global_rows = {}
        self._global_original = {}
        self._global_plug = None
        self._updating_global = False

        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)

        self.stack = QStackedWidget()
        layout.addWidget(self.stack)

        self.plug_list = QListWidget()
        self.plug_list.setSelectionMode(QListWidget.SelectionMode.NoSelection)
        plug_scroll = QScrollArea()
        plug_scroll.setWidgetResizable(True)
        plug_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        plug_scroll.setWidget(self.plug_list)
        self.stack.addWidget(plug_scroll)

        self.global_list = QListWidget()
        self.global_list.setSelectionMode(QListWidget.SelectionMode.NoSelection)
        global_scroll = QScrollArea()
        global_scroll.setWidgetResizable(True)
        global_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        global_scroll.setWidget(self.global_list)
        self.stack.addWidget(global_scroll)

    def set_global_plug(self, plug):
        self._global_plug = plug
        self._populate_global_list()

    def update_for_app(self, app_name):
        self.app_name = app_name
        if app_name == tr("GLOBAL_NAME"):
            self.stack.setCurrentIndex(1)
            self._populate_global_list()
            return

        self.plug_list.clear()
        self.rows = []
        status = get_plug_status_cached(app_name)
        visible = sorted(p for p in status if p in VISIBLE_PLUGS)

        if not visible:
            item = QListWidgetItem()
            lbl = QLabel(tr("TEXT_NO_PLUGS_FOUND"))
            lbl.setContentsMargins(0, 24, 0, 24)
            item.setSizeHint(lbl.sizeHint())
            self.plug_list.addItem(item)
            self.plug_list.setItemWidget(item, lbl)
        else:
            for plug in visible:
                desc = get_plug_description(plug)
                w = make_plug_row(plug, desc, status[plug])
                w.switch.stateChanged.connect(lambda _s: self.state_changed.emit())
                item = QListWidgetItem()
                item.setSizeHint(w.sizeHint())
                self.plug_list.addItem(item)
                self.plug_list.setItemWidget(item, w)
                self.rows.append({"plug": plug, "switch": w.switch, "original": status[plug]})

        self.stack.setCurrentIndex(0)
        self.state_changed.emit()

    def _populate_global_list(self):
        if self._updating_global:
            return
        self._updating_global = True

        self.global_list.clear()
        self._global_rows = {}
        self._global_original = {}

        plug = self._global_plug
        if not plug:
            self._updating_global = False
            return

        any_app = False
        for app_name, icon_spec in get_app_info_cached():
            status = get_plug_status_cached(app_name)
            if plug not in status:
                continue
            any_app = True
            is_connected = status[plug]
            self._global_original[app_name] = is_connected

            w = QWidget()
            hbox = QHBoxLayout(w)
            hbox.setContentsMargins(8, 4, 8, 4)
            hbox.setSpacing(8)

            switch = QCheckBox()
            switch.setChecked(is_connected)
            switch.stateChanged.connect(lambda _s: self.state_changed.emit())
            hbox.addWidget(switch, 0, Qt.AlignmentFlag.AlignVCenter)

            hbox.addWidget(make_icon_widget(icon_spec, 16), 0)

            vbox = QVBoxLayout()
            vbox.setSpacing(0)
            vbox.addWidget(QLabel(app_name))
            vbox.addWidget(QLabel(f"{app_name}:{plug}"))
            hbox.addLayout(vbox, 1)

            item = QListWidgetItem()
            item.setSizeHint(w.sizeHint())
            self.global_list.addItem(item)
            self.global_list.setItemWidget(item, w)
            self._global_rows[app_name] = switch

        if not any_app:
            item = QListWidgetItem()
            lbl = QLabel(tr("TEXT_NO_APPS_FOR_PLUG"))
            lbl.setContentsMargins(0, 24, 0, 24)
            item.setSizeHint(lbl.sizeHint())
            self.global_list.addItem(item)
            self.global_list.setItemWidget(item, lbl)

        self._updating_global = False
        self.state_changed.emit()

    def has_changes(self):
        if self.app_name == tr("GLOBAL_NAME"):
            for app_name, switch in self._global_rows.items():
                if switch.isChecked() != self._global_original.get(app_name, False):
                    return True
            return False
        for row in self.rows:
            if row["switch"].isChecked() != row["original"]:
                return True
        return False

    def collect_commands(self):
        commands = []
        if self.app_name is None:
            return commands
        if self.app_name == tr("GLOBAL_NAME"):
            plug = self._global_plug
            if not plug:
                return commands
            for app_name, switch in self._global_rows.items():
                current = switch.isChecked()
                original = self._global_original.get(app_name, False)
                if current != original:
                    action = "connect" if current else "disconnect"
                    commands.append(["snap", action, f"{app_name}:{plug}"])
        else:
            for row in self.rows:
                current = row["switch"].isChecked()
                if current != row["original"]:
                    action = "connect" if current else "disconnect"
                    commands.append(["snap", action, f"{self.app_name}:{row['plug']}"])
        return commands


# ---------- Main window ----------
class KyunnectWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(tr("APP_NAME"))
        icon_path = Path(__file__).resolve().parent / f"{APP_ID}.svg"
        if icon_path.is_file():
            self.setWindowIcon(QIcon(str(icon_path)))

        w = _settings.get("window_width", 900)
        h = _settings.get("window_height", 640)
        self.resize(w, h)
        self.setMinimumSize(600, 400)

        self._saved_width = w
        self._saved_height = h
        self._current_app = None
        self._bridge = _Bridge()
        self._bridge.done.connect(self._on_pkexec_done)

        central = QWidget()
        self.setCentralWidget(central)
        root = QVBoxLayout(central)
        root.setContentsMargins(0, 0, 0, 0)
        root.setSpacing(0)

        # Toolbar
        toolbar = QWidget()
        tb = QHBoxLayout(toolbar)
        tb.setContentsMargins(8, 6, 8, 6)
        tb.setSpacing(8)

        self.title_label = QLabel()
        f = QFont()
        f.setBold(True)
        self.title_label.setFont(f)
        self.title_label.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Preferred)
        tb.addWidget(self.title_label, 1)

        self.plug_label = QLabel(tr("TEXT_GLOBAL_PLUG_LABEL"))
        self.plug_label.setVisible(False)
        tb.addWidget(self.plug_label, 0)

        self.global_combo = QComboBox()
        for plug in VISIBLE_PLUGS:
            self.global_combo.addItem(plug)
        self.global_combo.setCurrentIndex(0)
        self.global_combo.setVisible(False)
        self.global_combo.currentIndexChanged.connect(self._on_global_plug_changed)
        tb.addWidget(self.global_combo, 0)

        self.apply_btn = QPushButton(tr("TEXT_APPLY"))
        self.apply_btn.setEnabled(False)
        self.apply_btn.clicked.connect(self._on_apply)
        tb.addWidget(self.apply_btn, 0)

        root.addWidget(toolbar)

        # Splitter
        self.splitter = QSplitter(Qt.Orientation.Horizontal)
        self.splitter.setChildrenCollapsible(False)
        root.addWidget(self.splitter, 1)

        self.sidebar = Sidebar()
        self.sidebar.setMinimumWidth(180)
        self.sidebar.selection_changed.connect(self._on_select)
        self.splitter.addWidget(self.sidebar)

        self.detail = DetailPanel()
        self.detail.setMinimumWidth(320)
        self.detail.state_changed.connect(self._update_apply_sensitivity)
        self.splitter.addWidget(self.detail)

        self.splitter.setCollapsible(0, False)
        self.splitter.setCollapsible(1, False)
        self.splitter.setStretchFactor(0, 0)
        self.splitter.setStretchFactor(1, 1)

        self.splitter.setSizes([260, 640])

        self._qsettings = QSettings("Kyunnect")
        saved_sizes = self._qsettings.value("splitterSizes")
        if saved_sizes:
            try:
                sizes = [int(s) for s in saved_sizes]
                if len(sizes) == 2:
                    self.splitter.setSizes(sizes)
            except (TypeError, ValueError):
                pass

        self._current_app = None
        self.detail.app_name = None
        self.detail.set_global_plug(self.global_combo.currentText())
        self.title_label.setText(tr("APP_NAME"))
        self._update_apply_sensitivity()
        self._update_toolbar_visibility()

        self.sidebar.select_first()

        if _settings.get("window_maximized", False):
            self.showMaximized()
        else:
            self.show()

    def resizeEvent(self, event):
        if not self.isMaximized():
            self._saved_width = self.width()
            self._saved_height = self.height()
        super().resizeEvent(event)

    def closeEvent(self, event):
        save_settings({
            "window_width": self._saved_width,
            "window_height": self._saved_height,
            "window_maximized": self.isMaximized(),
        })
        self._qsettings.setValue("splitterSizes", self.splitter.sizes())
        event.accept()

    def _update_toolbar_visibility(self):
        is_global = self._current_app == tr("GLOBAL_NAME")
        self.plug_label.setVisible(is_global)
        self.global_combo.setVisible(is_global)

    def _on_global_plug_changed(self, _index):
        self.detail.set_global_plug(self.global_combo.currentText())

    def _on_select(self, app_name):
        self._current_app = app_name
        self.title_label.setText(app_name)
        self.detail.update_for_app(app_name)
        self._update_apply_sensitivity()
        self._update_toolbar_visibility()

    def _update_apply_sensitivity(self):
        self.apply_btn.setEnabled(self.detail.has_changes())

    def _on_apply(self, _checked=False):
        commands = self.detail.collect_commands()
        if not commands:
            self._update_apply_sensitivity()
            return
        self.apply_btn.setEnabled(False)
        self.apply_btn.setText(tr("TEXT_PLEASE_WAIT"))

        self.sidebar.setEnabled(False)
        self.detail.setEnabled(False)
        self.global_combo.setEnabled(False)

        run_pkexec_commands(commands, self._bridge)

    def _on_pkexec_done(self, ok):
        self.apply_btn.setText(tr("TEXT_APPLY"))
        self.sidebar.setEnabled(True)
        self.detail.setEnabled(True)
        self.global_combo.setEnabled(True)

        if ok:
            invalidate_cache()
            if self._current_app == tr("GLOBAL_NAME"):
                self.detail._populate_global_list()
            else:
                self.detail.update_for_app(self._current_app)
        else:
            self._update_apply_sensitivity()


# ---------- Main ----------
def main():
    kyunnect_config_dir.mkdir(parents=True, exist_ok=True)

    app = QApplication(sys.argv)
    app.setApplicationName(tr("APP_NAME"))
    app.setDesktopFileName(APP_ID)

    win = KyunnectWindow()
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
