        self.paned = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
        self.paned.set_position(260)
        root.pack_start(self.paned, True, True, 0)

        self.sidebar = Sidebar(self._on_select)
        self.sidebar.set_size_request(180, -1)
        self.paned.pack1(self.sidebar, False, False)

        self.detail = DetailPanel(self._update_apply_sensitivity)
        self.paned.pack2(self.detail, True, False)

        self.connect("destroy", Gtk.main_quit)
        self.show_all()

        self.sidebar.clear_selection()
        self._current_app = None
        self.detail.app_name = None
        self.detail.set_global_plug(self.global_combo.get_active_text())
        self.detail.stack.set_visible_child_name("welcome")
        self.title_label.set_markup(f"<b>{GLib.markup_escape_text(tr('APP_NAME'))}</b>")
        self._update_apply_sensitivity()
        self._update_toolbar_visibility()

    def _update_toolbar_visibility(self):
        is_global = self._current_app == tr("GLOBAL_NAME")
        self.plug_label.set_visible(is_global)
        self.global_combo.set_visible(is_global)

    def _on_global_plug_changed(self, combo):
        self.detail.set_global_plug(combo.get_active_text())

    def _on_select(self, app_name):
        self._current_app = app_name
        self.title_label.set_markup(f"<b>{GLib.markup_escape_text(app_name)}</b>")
        self.detail.update_for_app(app_name)
        self._update_apply_sensitivity()
        self._update_toolbar_visibility()

    def _update_apply_sensitivity(self):
        self.apply_btn.set_sensitive(self.detail.has_changes())

    def _on_apply(self, _button):
        commands = self.detail.collect_commands()
        if not commands:
            self._update_apply_sensitivity()
            return
        self.apply_btn.set_sensitive(False)
        self.apply_btn.set_label(tr("TEXT_PLEASE_WAIT"))

        self.sidebar.set_sensitive(False)
        self.detail.set_sensitive(False)
        self.global_combo.set_sensitive(False)

        def done(ok):
            self.apply_btn.set_label(tr("TEXT_APPLY"))
            self.sidebar.set_sensitive(True)
            self.detail.set_sensitive(True)
            self.global_combo.set_sensitive(True)

            if ok:
                invalidate_cache()
                if self._current_app == tr("GLOBAL_NAME"):
                    self.detail._populate_global_list()
                else:
                    self.detail.update_for_app(self._current_app)
            else:
                self._update_apply_sensitivity()
            return False

        run_pkexec_commands(commands, done)


# ---------- Main ----------
def main():
    kyunnect_config_dir.mkdir(parents=True, exist_ok=True)
    kyunnect_translation_dir.mkdir(parents=True, exist_ok=True)

    win = KyunnectWindow()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())