def make_plug_row(plug, description, is_connected):
    row = Gtk.ListBoxRow()
    row.set_selectable(False)
    row.set_activatable(False)
    hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
    hbox.set_margin_top(8)
    hbox.set_margin_bottom(8)
    hbox.set_margin_start(14)
    hbox.set_margin_end(14)

    hbox.pack_start(make_icon_widget(get_plug_icon(plug), 20), False, False, 0)

    vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
    vbox.set_hexpand(True)
    desc_label = Gtk.Label(label=description, xalign=0)
    desc_label.set_line_wrap(True)
    desc_label.set_max_width_chars(50)
    vbox.pack_start(desc_label, False, False, 0)
    name_label = Gtk.Label(xalign=0)
    name_label.set_markup(f"<small><span foreground='#888888'>{GLib.markup_escape_text(plug)}</span></small>")
    vbox.pack_start(name_label, False, False, 0)
    hbox.pack_start(vbox, True, True, 0)
    switch = Gtk.Switch()
    switch.set_active(is_connected)
    switch.set_valign(Gtk.Align.CENTER)
    hbox.pack_end(switch, False, False, 0)
    row.add(hbox)
    row.plug = plug
    row.original = is_connected
    row.switch = switch
    return row


# ---------- Sidebar ----------
class Sidebar(Gtk.ScrolledWindow):
    def __init__(self, on_select):
        super().__init__()
        self.on_select = on_select
        self._suppress = False
        self.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.listbox = Gtk.ListBox()
        self.listbox.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.listbox.connect("row-selected", self._on_row_selected)
        self.add(self.listbox)
        self.reload()

    def reload(self):
        self._suppress = True
        for child in self.listbox.get_children():
            self.listbox.remove(child)
        self.listbox.add(make_global_sidebar_row())
        for app_name, icon_spec in get_app_info_cached():
            self.listbox.add(make_sidebar_row(app_name, icon_spec))
        self.listbox.show_all()
        self._suppress = False

    def _on_row_selected(self, listbox, row):
        if self._suppress or row is None:
            return
        app_name = getattr(row, "app_name", None)
        if app_name:
            self.on_select(app_name)

    def clear_selection(self):
        self._suppress = True
        self.listbox.unselect_all()
        self._suppress = False


# ---------- Detail panel ----------
class DetailPanel(Gtk.Box):
    def __init__(self, on_state_changed):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.on_state_changed = on_state_changed
        self.app_name = None
        self.rows = []
        self._global_rows = {}
        self._global_original = {}
        self._global_plug = None
        self._updating_global = False

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.pack_start(self.stack, True, True, 0)

        # Plugs page
        self.plug_list = Gtk.ListBox()
        self.plug_list.set_selection_mode(Gtk.SelectionMode.NONE)
        plug_scroll = Gtk.ScrolledWindow()
        plug_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        plug_scroll.add(self.plug_list)
        self.stack.add_named(plug_scroll, "plugs")

        # Global page
        global_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.global_list = Gtk.ListBox()
        self.global_list.set_selection_mode(Gtk.SelectionMode.NONE)
        global_scroll = Gtk.ScrolledWindow()
        global_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        global_scroll.set_vexpand(True)
        global_scroll.add(self.global_list)
        global_box.pack_start(global_scroll, True, True, 0)
        self.stack.add_named(global_box, "global")

        # Welcome page
        welcome_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        welcome_box.set_valign(Gtk.Align.CENTER)
        welcome_box.set_halign(Gtk.Align.CENTER)

        welcome_icon = Gtk.Image()
        welcome_icon.set_size_request(256, 256)
        icon_path = Path(__file__).resolve().parent / f"{APP_ID}.svg"
        loaded = False
        if icon_path.is_file():
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(icon_path), 256, 256, True)
                welcome_icon.set_from_pixbuf(pixbuf)
                loaded = True
            except Exception as e:
                print(f"[Kyunnect]: failed to load local icon: {e}")

        if not loaded:
            welcome_icon.set_pixel_size(256)
            icon_theme = Gtk.IconTheme.get_default()
            if icon_theme.has_icon(APP_ID):
                welcome_icon.set_from_icon_name(APP_ID, Gtk.IconSize.DIALOG)
            else:
                welcome_icon.set_from_icon_name("application-x-executable", Gtk.IconSize.DIALOG)
        welcome_box.pack_start(welcome_icon, False, False, 0)

        welcome_label = Gtk.Label()
        welcome_label.set_markup(
            f"<span size='x-large' weight='bold'>{GLib.markup_escape_text(tr('WELCOME'))}</span>"
        )
        welcome_box.pack_start(welcome_label, False, False, 0)

        self.stack.add_named(welcome_box, "welcome")

    def set_global_plug(self, plug):
        self._global_plug = plug
        self._populate_global_list()

    def update_for_app(self, app_name):
        self.app_name = app_name
        if app_name == tr("GLOBAL_NAME"):
            self.stack.set_visible_child_name("global")
            self._populate_global_list()
            return

        for child in self.plug_list.get_children():
            self.plug_list.remove(child)
        self.rows = []
        status = get_plug_status_cached(app_name)
        visible = sorted(p for p in status if p in VISIBLE_PLUGS)

        if not visible:
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label=tr("TEXT_NO_PLUGS_FOUND"))
            lbl.set_margin_top(24)
            lbl.set_margin_bottom(24)
            row.add(lbl)
            self.plug_list.add(row)
        else:
            for plug in visible:
                desc = get_plug_description(plug)
                row = make_plug_row(plug, desc, status[plug])
                row.switch.connect("notify::active", self._on_switch_toggled)
                self.rows.append(row)
                self.plug_list.add(row)

        self.plug_list.show_all()
        self.stack.set_visible_child_name("plugs")
        self.on_state_changed()

    def _populate_global_list(self):
        if self._updating_global:
            return
        self._updating_global = True

        for child in self.global_list.get_children():
            self.global_list.remove(child)
        self._global_rows = {}
        self._global_original = {}

        plug = self._global_plug
        if not plug:
            self._updating_global = False
            return

        any_app = False
        for app_name, icon_spec in get_app_info_cached():
            status = get_plug_status_cached(app_name)
            if plug not in status:
                continue
            any_app = True
            is_connected = status[plug]
            self._global_original[app_name] = is_connected

            row = Gtk.ListBoxRow()
            row.set_selectable(False)
            row.set_activatable(False)
            hbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
            hbox.set_margin_top(8)
            hbox.set_margin_bottom(8)
            hbox.set_margin_start(14)
            hbox.set_margin_end(14)
            hbox.pack_start(make_icon_widget(icon_spec, 20), False, False, 0)
            vbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            vbox.set_hexpand(True)
            vbox.pack_start(Gtk.Label(label=app_name, xalign=0), False, False, 0)
            plug_label = Gtk.Label(xalign=0)
            plug_label.set_markup(f"<small><span foreground='#888888'>{GLib.markup_escape_text(app_name + ':' + plug)}</span></small>")
            vbox.pack_start(plug_label, False, False, 0)
            hbox.pack_start(vbox, True, True, 0)
            switch = Gtk.Switch()
            switch.set_active(is_connected)
            switch.set_valign(Gtk.Align.CENTER)
            switch.connect("notify::active", self._on_switch_toggled)
            hbox.pack_end(switch, False, False, 0)
            row.add(hbox)
            self.global_list.add(row)
            self._global_rows[app_name] = switch

        if not any_app:
            row = Gtk.ListBoxRow()
            lbl = Gtk.Label(label=tr("TEXT_NO_APPS_FOR_PLUG"))
            lbl.set_margin_top(24)
            lbl.set_margin_bottom(24)
            row.add(lbl)
            self.global_list.add(row)

        self.global_list.show_all()
        self._updating_global = False
        self.on_state_changed()

    def _on_switch_toggled(self, switch, _pspec):
        self.on_state_changed()

    def has_changes(self):
        if self.app_name == tr("GLOBAL_NAME"):
            for app_name, switch in self._global_rows.items():
                if switch.get_active() != self._global_original.get(app_name, False):
                    return True
            return False
        for row in self.rows:
            if row.switch.get_active() != row.original:
                return True
        return False

    def collect_commands(self):
        commands = []
        if self.app_name is None:
            return commands
        if self.app_name == tr("GLOBAL_NAME"):
            plug = self._global_plug
            if not plug:
                return commands
            for app_name, switch in self._global_rows.items():
                current = switch.get_active()
                original = self._global_original.get(app_name, False)
                if current != original:
                    action = "connect" if current else "disconnect"
                    commands.append(["snap", action, f"{app_name}:{plug}"])
        else:
            for row in self.rows:
                current = row.switch.get_active()
                if current != row.original:
                    action = "connect" if current else "disconnect"
                    commands.append(["snap", action, f"{self.app_name}:{row.plug}"])
        return commands


