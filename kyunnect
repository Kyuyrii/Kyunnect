# ---------- Snap data ----------
def get_app_info():
    try:
        out = subprocess.check_output(["snap", "list"], text=True).strip().split("\n")
        if len(out) <= 1:
            return []
        apps = []
        for line in out[1:]:
            parts = line.split()
            if not parts:
                continue
            name = parts[0]
            if name in EXCLUDED_APPS:
                continue
            notes = parts[-1].lower() if len(parts) >= 6 else ""
            if "classic" in notes:
                continue
            note_tokens = set(notes.replace(",", " ").split())
            if note_tokens & RUNTIME_NOTES:
                continue
            if "disabled" in notes:
                continue
            desktop_files = globmod.glob(f"/var/lib/snapd/desktop/applications/{name}*.desktop")
            icon = ""
            if desktop_files:
                try:
                    with open(desktop_files[0], "r", encoding="utf-8", errors="ignore") as f:
                        for fl in f:
                            if fl.startswith("Icon="):
                                icon = fl.strip().split("=", 1)[1]
                                break
                except Exception:
                    pass
            if not icon:
                continue
            apps.append((name, icon))
        return apps
    except (FileNotFoundError, subprocess.CalledProcessError):
        return []


def get_plug_status(app_name):
    status = {}
    try:
        out = subprocess.check_output(["snap", "connections", app_name], text=True).strip().split("\n")
        for line in out[1:]:
            parts = line.split()
            if len(parts) < 3:
                continue
            plug = parts[0]
            if plug.startswith("content["):
                continue
            if plug not in VISIBLE_PLUGS:
                continue
            plug_full = parts[1]
            if ":" not in plug_full:
                continue
            plug_name = plug_full.split(":", 1)[1]
            if plug_name != plug:
                continue
            status[plug] = parts[2] != "-"
    except Exception:
        pass
    return status


# ---------- Caching ----------
_cache = {}
_cache_time = {}
CACHE_TTL = 3.0


def _cached(key, func, *args):
    now = time.monotonic()
    if key in _cache and (now - _cache_time[key]) < CACHE_TTL:
        return _cache[key]
    value = func(*args)
    _cache[key] = value
    _cache_time[key] = now
    return value


def get_app_info_cached():
    return _cached(("app_info",), get_app_info)


def get_plug_status_cached(app_name):
    return _cached(("plug_status", app_name), get_plug_status, app_name)


def invalidate_cache():
    _cache.clear()
    _cache_time.clear()


def get_plug_description(plug):
    key = "PLUG_" + plug.upper().replace("-", "_")
    translated = tr(key)
    if translated != key:
        return translated
    return plug


def get_plug_icon(plug):
    return PLUG_ICONS.get(plug, "application-x-executable")


# ---------- Async pkexec ----------
def run_pkexec_commands(commands, callback):
    def worker():
        if not commands:
            GLib.idle_add(callback, True)
            return
        joined = " && ".join(" ".join(c) for c in commands)
        full = ["pkexec", "sh", "-c", joined]
        try:
            subprocess.run(full, check=True)
            GLib.idle_add(callback, True)
        except subprocess.CalledProcessError:
            GLib.idle_add(callback, False)
        except Exception as e:
            print(f"[Kyunnect]: pkexec error: {e}")
            GLib.idle_add(callback, False)
    t = threading.Thread(target=worker, daemon=True)
    t.start()


# ---------- Helpers ----------
def make_icon_widget(icon_spec, size=24):
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
    box.set_size_request(size, size)
    box.set_halign(Gtk.Align.CENTER)
    box.set_valign(Gtk.Align.CENTER)
    box.set_vexpand(False)
    box.set_hexpand(False)

    if icon_spec and os.path.isabs(icon_spec) and os.path.isfile(icon_spec):
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(icon_spec, size, size, True)
            image = Gtk.Image.new_from_pixbuf(pixbuf)
        except Exception:
            image = Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.DND)
            image.set_pixel_size(size)
    elif icon_spec:
        image = Gtk.Image.new_from_icon_name(icon_spec, Gtk.IconSize.DND)
        image.set_pixel_size(size)
    else:
        image = Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.DND)
        image.set_pixel_size(size)

    image.set_size_request(size, size)
    image.set_valign(Gtk.Align.CENTER)
    image.set_halign(Gtk.Align.CENTER)
    image.set_vexpand(False)
    box.pack_start(image, False, False, 0)
    return box


def make_sidebar_row(app_name, icon_spec):
