#!/bin/bash

sudo apt install python3-venv -y

python3 -m venv venv
source venv/bin/activate
pip install pyinstaller PyQt6 PyQt6-Qt6 tomlkit

pyinstaller --onefile --windowed --name Kyunnect kyunnect

if ! command -v appimagetool &> /dev/null; then
    echo "Downloading appimagetool..."
    wget https://github.com/AppImage/appimagetool/releases/download/1.9.1/appimagetool-x86_64.AppImage -O appimagetool
    chmod +x appimagetool
fi

# Create AppDir structure
mkdir -p AppDir

# Copy Kyunnect files
echo "Copying files to AppDir..."

# Copy the Kyunnect binary that was generated with PyInstaller.
cp dist/Kyunnect AppDir/

# Copy translation folder
cp -r translation AppDir/

# Copy .svg and .desktop files
cp io.github.kyuyrii.kyunnect.svg AppDir/
cp io.github.kyuyrii.kyunnect.desktop AppDir/

# Copy Kyunnect code.
# This isn't important for the AppImage to function; it's just to have easier access to the Kyunnect code.
cp kyunnect AppDir/

# Create AppRun
cat > AppDir/AppRun << 'EOF'
#!/bin/bash
if [ -z "$APPIMAGE" ]; then
    self="$(readlink -f -- "$0")"
    export APPDIR="${self%/*}"
fi

export QT_QPA_PLATFORMTHEME=gtk3

exec "$APPDIR/Kyunnect" "$@"
EOF
chmod +x AppDir/AppRun

# Generate AppImage
ARCH=x86_64 ./appimagetool AppDir

echo "AppImage created: $(ls *.AppImage)"
